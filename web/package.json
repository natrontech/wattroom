{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.e2e.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write src e2e",
		"format:check": "prettier --check src e2e",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/chakra-petch": "^5.3.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/suncalc": "1.9.2",
		"@types/three": "0.186.0",
		"@types/web-bluetooth": "^0.0.22",
		"fake-indexeddb": "^6.2.8",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.5.1",
	"dependencies": {
		"@lucide/svelte": "^1.71.0",
		"@workadventure/noise-suppression": "0.2.0",
		"emojibase-data": "18.0.0",
		"livekit-client": "^2.23.0",
		"suncalc": "1.9.0",
		"three": "0.186.1"
	}
}
