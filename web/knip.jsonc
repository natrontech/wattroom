// Dead code in the web app: unused files, exports and dependencies (#3862).
// `make dead-code` runs it, and so does CI's advisory `dead-code` job. The
// SvelteKit, Vite, Vitest and Playwright plugins find their own entries.
// Every exception below carries its reason; an export nobody imports is
// deleted, not added here.
{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// CLIs run by hand, by the Makefile and by CI, and the e2e harness's
	// server that playwright.config.ts starts with `node`.
	"entry": ["scripts/*.mjs", "e2e/server.js"],
	"ignoreIssues": {
		// Generated by tygo from server/internal/protocol (`make protocol`): it
		// mirrors every Go export whether or not the client reads it.
		"src/lib/protocol.ts": ["exports", "types"],
		// Read as `passkeys.add()` behind `import * as passkeys` in .svelte
		// files, and knip sees only a .svelte file's import lines.
		"src/lib/passkeys.ts": ["exports"],
	},
	// System tools the scripts shell out to, not packages.
	"ignoreBinaries": ["go", "ffmpeg"],
	// An export also used in its own file is not dead, only wider than it
	// needs to be.
	"ignoreExportsUsedInFile": true,
	"rules": {
		// Not dead code: two names for one value (SHARE_MARK = MUTED_MARK).
		"duplicates": "off",
	},
}
