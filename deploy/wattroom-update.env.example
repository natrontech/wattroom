# Copy to /etc/wattroom-update.env on the VM. No secrets: the registry
# credential is the one `docker login ghcr.io` already stored.

# Where the compose stack and its .env live.
STACK_DIR=/opt/wattroom

# The image to track. The newest CalVer tag published here is the target;
# :main and :<sha> are built too and are ignored.
IMAGE_REPO=natrontech/wattroom
REGISTRY=ghcr.io

# Credentials are reused from `docker login ghcr.io` — nothing to set here.
# Uncomment only if this VM uses a docker credential *helper*, which stores
# nothing in config.json for the script to read.
# GHCR_USER=your-github-user
# GHCR_TOKEN=ghp_...

# Where deploy events go. The default writes to the journal; point it at
# whatever already reaches a phone. This is convenience, not the safety net —
# Prometheus alerts on a broken production whether or not this fires.
# NOTIFY_CMD=curl -s -d @- https://ntfy.example/wattroom

# How long a new release gets to report its own tag and answer healthz before
# it is rolled back.
GATE_TIMEOUT=90

# Where the stack publishes the app on this host's loopback. Only change this
# if you changed the published port in docker-compose.prod.yml.
APP_URL=http://127.0.0.1:8080
