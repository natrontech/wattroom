# Copy to livekit.yaml. Real keys — --dev never reaches production.
port: 7880
rtc:
  use_external_ip: true
keys:
  # livekit-server generate-keys; mirror into .env WATTROOM_LIVEKIT_KEY/SECRET.
  REPLACE_KEY: REPLACE_SECRET
webhook:
  # The sidebar radar (#149): participant events feed the app's voice map.
  # LiveKit is on the host network, where compose names like `wattroom` do not
  # resolve; the compose file publishes the server on the host's loopback
  # (#2827).
  api_key: REPLACE_KEY
  urls:
    - http://127.0.0.1:8080/api/livekit/webhook
