{$DOMAIN} {
	# The SPA shell is ~390 KB of JS and CSS uncompressed and ~140 KB encoded.
	# Caddy does not compress unless asked, and the Go binary serves the
	# embedded build raw. Media is exempt on its own: LiveKit's audio and video
	# never pass through here (ADR-0002), and Caddy skips already-compressed
	# types anyway.
	#
	# wattroom.ch does NOT get this from here — that edge is its own Caddy in
	# the operator's infrastructure repo, which carries its own `encode`. This
	# line is for everyone self-hosting from this file.
	encode zstd gzip

	# WS upgrade and everything else to the one binary.
	reverse_proxy wattroom:8080

	# /metrics is not served on 8080 at all since #1738 — it has its own
	# listener on 9091, which nothing here proxies. This block stays as a
	# second lock: an edge that forgets it is no longer the only thing
	# between rider counts and the internet, which is exactly what it was.
	handle /metrics* {
		respond 404
	}

	# LiveKit signaling; media flows over host-network UDP directly.
	handle_path /livekit* {
		reverse_proxy localhost:7880
	}

	# Binary unreachable (deploy, crash, `compose stop wattroom` for planned
	# maintenance): the self-contained maintenance page, which reloads itself
	# off /api/healthz. Real status code kept so probes still see the outage.
	handle_errors {
		root * /srv
		rewrite * /maintenance.html
		header Cache-Control no-store
		header Retry-After 30
		file_server {
			status {err.status_code}
		}
	}
}
