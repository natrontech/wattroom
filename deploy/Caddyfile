{$DOMAIN} {
	# WS upgrade and everything else to the one binary.
	reverse_proxy wattroom:8080

	# /metrics belongs to the homelab's Prometheus, which reaches the container
	# directly over the monitoring network (ADR-0019) — it is never the
	# internet's. Rider counts are room-scoped data, and the Go handler is
	# mounted bare on the mux, so this block is the only thing gating it.
	handle /metrics* {
		respond 404
	}

	# LiveKit signaling; media flows over host-network UDP directly.
	handle_path /livekit* {
		reverse_proxy localhost:7880
	}

	# Binary unreachable (deploy, crash, `compose stop wattroom` for planned
	# maintenance): the self-contained maintenance page, which reloads itself
	# off /api/healthz. Real status code kept so probes still see the outage.
	handle_errors {
		root * /srv
		rewrite * /maintenance.html
		header Cache-Control no-store
		header Retry-After 30
		file_server {
			status {err.status_code}
		}
	}
}
