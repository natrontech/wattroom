# Copy to .env beside docker-compose.prod.yml. Secrets stay on the VM
# (sops-managed in the homelab repo) — never in this repository.
DOMAIN=wattroom.ch

# The release this VM runs (ADR-0019). Bump it and `up -d wattroom`; rolling
# back is the same move with the previous tag. Never point this at :main — a
# moving tag has no previous version to go back to.
WATTROOM_TAG=2026.09.1
POSTGRES_PASSWORD=change-me

# OAuth apps (#16). Callback URLs: https://wattroom.ch/api/auth/<provider>/callback
WATTROOM_OAUTH_GOOGLE_ID=
WATTROOM_OAUTH_GOOGLE_SECRET=
WATTROOM_OAUTH_GITHUB_ID=
WATTROOM_OAUTH_GITHUB_SECRET=
WATTROOM_OAUTH_STRAVA_ID=
WATTROOM_OAUTH_STRAVA_SECRET=

# LiveKit: generate a real key pair (livekit-server generate-keys) and put the
# same values in livekit.yaml.
WATTROOM_LIVEKIT_KEY=
WATTROOM_LIVEKIT_SECRET=

# Feedback -> GitHub issues (#53). A fine-scoped token with issues:write.
WATTROOM_GITHUB_TOKEN=
WATTROOM_GITHUB_REPO=natrontech/wattroom

# Production ride synthetic (#153). A long-lived bearer for one minimal-grant
# account; the systemd timer on the VM is the only thing that uses it.
# Unset = POST /api/auth/synthetic returns 404, the path does not exist.
WATTROOM_SYNTHETIC_TOKEN=
