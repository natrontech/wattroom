# Copy to .env beside docker-compose.prod.yml. Replace every <...> placeholder;
# this file contains examples only. Keep real values in your secret manager.

# Required by Docker Compose: the published release tag, database password, and
# public hostname. Compose derives WATTROOM_DB, WATTROOM_BASE_URL,
# WATTROOM_LIVEKIT_URL, and WATTROOM_FEEDBACK_DIR from these values.
WATTROOM_TAG=<release-tag>
POSTGRES_PASSWORD=<database-password>
DOMAIN=<public-hostname>

# Optional VM-updater pin. Unset tracks the newest published release; setting a
# release tag holds it there after a deliberate or health-gate rollback.
# WATTROOM_PIN=<release-tag>

# Sign-in providers. A missing ID or secret hides that provider's button;
# leaving all three unconfigured leaves the login screen with no provider.
WATTROOM_OAUTH_GOOGLE_ID=<google-oauth-client-id>
WATTROOM_OAUTH_GOOGLE_SECRET=<google-oauth-client-secret>
WATTROOM_OAUTH_GITHUB_ID=<github-oauth-client-id>
WATTROOM_OAUTH_GITHUB_SECRET=<github-oauth-client-secret>
WATTROOM_OAUTH_STRAVA_ID=<strava-oauth-client-id>
WATTROOM_OAUTH_STRAVA_SECRET=<strava-oauth-client-secret>

# Voice and camera. URL comes from DOMAIN in Compose; without this key or
# secret, the server does not mount AV and the web hides its controls.
WATTROOM_LIVEKIT_KEY=<livekit-api-key>
WATTROOM_LIVEKIT_SECRET=<livekit-api-secret>

# Session email. Without the Resend key, session notifications and their
# profile settings are absent. MAIL_FROM falls back to rides@wattroom.ch.
WATTROOM_RESEND_KEY=<resend-api-key>
WATTROOM_MAIL_FROM=WattRoom <rides@example.com>

# Feedback issue filing. Without either token or repository, reports remain
# on disk in the Compose-managed feedback directory instead of opening issues.
WATTROOM_GITHUB_TOKEN=<github-token>
WATTROOM_GITHUB_REPO=<owner/repository>

# Monitoring. Without this token, POST /api/auth/synthetic returns 404.
WATTROOM_SYNTHETIC_TOKEN=<synthetic-monitor-token>

# Development only: setting this to 1 creates an unauthenticated Dev Rider
# sign-in. Never set it in production.
# WATTROOM_DEV_LOGIN=1

# Usually unset in production. Extra comma-separated WebAuthn origins are only
# needed when a second development origin, such as Vite, must use passkeys.
# WATTROOM_EXTRA_ORIGINS=http://localhost:5174

# These server settings use their defaults in production. WATTROOM_ADDR defaults
# to :8080; WATTROOM_BUILD_SHA and WATTROOM_VERSION default to dev and are set
# by the image build when applicable.
# WATTROOM_ADDR=:8080
# WATTROOM_BUILD_SHA=<build-commit>
# WATTROOM_VERSION=<build-version>
