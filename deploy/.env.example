# Copy to .env beside docker-compose.prod.yml. Replace every <...> placeholder;
# this file contains examples only. Keep real values in your secret manager.

# Required by Docker Compose: the published release tag, database password, and
# public hostname. Compose derives WATTROOM_DB, WATTROOM_BASE_URL, and
# WATTROOM_LIVEKIT_URL; it sets WATTROOM_FEEDBACK_DIR to /data/feedback.
WATTROOM_TAG=<release-tag>
POSTGRES_PASSWORD=<database-password>
DOMAIN=<public-hostname>

# Optional VM-updater pin. Unset tracks the newest published release; setting a
# release tag holds it there after a deliberate or health-gate rollback.
# WATTROOM_PIN=<release-tag>

# Sign-in providers. Callbacks use https://${DOMAIN}/api/auth/<provider>/callback.
# A missing ID or secret hides that provider's button; leaving all three
# unconfigured leaves the login screen with no provider.
WATTROOM_OAUTH_GOOGLE_ID=
WATTROOM_OAUTH_GOOGLE_SECRET=
WATTROOM_OAUTH_GITHUB_ID=
WATTROOM_OAUTH_GITHUB_SECRET=
WATTROOM_OAUTH_STRAVA_ID=
WATTROOM_OAUTH_STRAVA_SECRET=

# Voice and camera. URL comes from DOMAIN in Compose; generate a real key pair
# with livekit-server generate-keys and mirror these values into livekit.yaml.
# Without either value, the server does not mount AV and the web hides its controls.
WATTROOM_LIVEKIT_KEY=
WATTROOM_LIVEKIT_SECRET=

# Email. Without the Resend key, planned-session notification controls are
# absent and email confirmation cannot send a link. MAIL_FROM defaults to
# WattRoom <rides@wattroom.ch> when the key is configured.
WATTROOM_RESEND_KEY=
WATTROOM_MAIL_FROM=

# Feedback issue filing. Without either token or repository, reports remain
# on disk in the Compose-managed feedback directory instead of opening issues.
WATTROOM_GITHUB_TOKEN=
WATTROOM_GITHUB_REPO=

# Monitoring. Without this token, POST /api/auth/synthetic returns 404.
WATTROOM_SYNTHETIC_TOKEN=

# Development only: setting this to 1 creates an unauthenticated Dev Rider
# sign-in. Never set it in production.
# WATTROOM_DEV_LOGIN=1

# Usually unset in production. Extra comma-separated WebAuthn origins are only
# needed when a second development origin, such as Vite, must use passkeys.
# WATTROOM_EXTRA_ORIGINS=http://localhost:5174

# Non-Compose defaults. Without WATTROOM_DB, only solo-ride endpoints mount;
# without WATTROOM_BASE_URL, callbacks use http://localhost:8080. A direct
# server deployment can set these instead of relying on Compose.
# WATTROOM_DB=postgres://wattroom:<database-password>@postgres:5432/wattroom
# WATTROOM_BASE_URL=https://<public-hostname>
# WATTROOM_LIVEKIT_URL=wss://<public-hostname>/livekit
# WATTROOM_FEEDBACK_DIR=feedback

# WATTROOM_ADDR defaults to :8080. WATTROOM_BUILD_SHA is used only when Go's
# VCS build metadata has no revision; WATTROOM_VERSION defaults to dev.
# WATTROOM_ADDR=:8080
# WATTROOM_BUILD_SHA=<build-commit>
# WATTROOM_VERSION=<build-version>
